# Required
OPENAI_API_KEY=your_openai_key_here
SERPAPI_API_KEY=your_serpapi_key_here

# Tracing (optional — traces are silently dropped if not set)
# Point this at the Observe Agent's OTLP HTTP receiver. Use
# host.docker.internal when running TravelShaper inside Docker and the agent
# on the host (Mac/Windows); on Linux use the host's IP or run the agent in
# the same Docker network.
TRACELOOP_BASE_URL=http://localhost:4318
TRACELOOP_TRACE_CONTENT=true

# Protocol switch. Default is HTTP/protobuf to port 4318 (TRACELOOP_BASE_URL
# above). To send gRPC to port 4317 instead, set:
#   OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Inside Docker / Podman the gRPC endpoint defaults to host.docker.internal:4317
# (defined in docker-compose.yml). Override only if your agent listens elsewhere.
# When PROTOCOL=grpc, TRACELOOP_BASE_URL is ignored.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4317

# Resource attributes attached to every span (comma-separated key=value).
# These power Observe Trace Explorer facets like environment, service.version,
# service.namespace, and service.instance.id. agent.py parses this env var
# and passes it to Traceloop.init explicitly. service.instance.id defaults
# to the container hostname; override here only if you want a stable name.
OTEL_RESOURCE_ATTRIBUTES=service.version=0.3.0,service.namespace=travelshaper,deployment.environment=dev

# Debug
TRAVELSHAPER_DEBUG=false
